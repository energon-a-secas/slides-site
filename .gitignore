# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Playwright MCP (Claude Code browser automation — screenshots, logs) ───────
.playwright-mcp/

# ── Playwright test artifacts ─────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json

# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*

# ── Cloud-sync conflict copies (daemon always inserts a space) ────────────────
* [0-9]
* [0-9].*

# ── Scratch decks ──────────────────────────────────────────────────────────────
.tmp-*

# ── Neorgon base (enforced by smoke check 20) ─────────────────────────────────
!.env.example
.forge/
__pycache__/
*.py[cod]
skills-archived/
*.log
